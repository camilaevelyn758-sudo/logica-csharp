        static void CadastrarPaciente()
        {
            var p = new Paciente { Id = pacientes.Count + 1 };
            Console.Write("Nome: "); p.Nome = Console.ReadLine() ?? "";
            Console.Write("CPF: "); p.CPF = Console.ReadLine() ?? "";
            Console.Write("Data Nasc (dd/mm/aaaa): "); DateTime.TryParse(Console.ReadLine(), out DateTime d); p.DataNascimento = d;
            Console.Write("Tipo Sanguíneo: "); p.TipoSanguineo = Console.ReadLine() ?? "";
            Console.Write("Alergias: "); p.Alergias = Console.ReadLine() ?? "";
            Console.Write("Contato Emergência: "); p.ContatoEmergencia = Console.ReadLine() ?? "";
            pacientes.Add(p);
            Console.WriteLine("Paciente registado com ID " + p.Id);
        }

        static void CadastrarMedico()
        {
            var m = new Medico { Id = medicos.Count + 1 };
            Console.Write("Nome: "); m.Nome = Console.ReadLine() ?? "";
            Console.Write("CRM: "); m.CRM = Console.ReadLine() ?? "";
            Console.Write("Especialidade: "); m.Especialidade = Console.ReadLine() ?? "";
            Console.Write("Telefone: "); m.Telefone = Console.ReadLine() ?? "";
            medicos.Add(m);
            Console.WriteLine("Médico registado com ID " + m.Id);
        }

        static void CadastrarLeito()
        {
            var l = new Leito { Id = leitos.Count + 1 };
            Console.Write("Nº Quarto: "); l.NumeroQuarto = Console.ReadLine() ?? "";
            Console.Write("Tipo (UTI/Enfermaria): "); l.Tipo = Console.ReadLine() ?? "";
            leitos.Add(l);
            Console.WriteLine("Leito registado com ID " + l.Id);
        }

        static void RegistrarInternacao()
        {
            Console.Write("ID Paciente: "); int.TryParse(Console.ReadLine(), out int idP);
            Console.Write("ID Médico: "); int.TryParse(Console.ReadLine(), out int idM);
            Console.Write("ID Leito Livre: "); int.TryParse(Console.ReadLine(), out int idL);

            var leito = leitos.FirstOrDefault(l => l.Id == idL && !l.EstaOcupado);
            if (leito == null) { Console.WriteLine("Leito indisponível ou inexistente."); return; }

            Console.Write("Diagnóstico: "); string diag = Console.ReadLine() ?? "";

            internacoes.Add(new Internacao
            {
                Id = internacoes.Count + 1,
                PacienteId = idP,
                MedicoResponsavelId = idM,
                LeitoId = idL,
                DataEntrada = DateTime.Now,
                DiagnosticoEntrada = diag
            });

            leito.EstaOcupado = true;
            Console.WriteLine("Internação registrada com sucesso!");
        }

        static void DarAlta()
        {
            Console.Write("ID Internação: "); int.TryParse(Console.ReadLine(), out int id);
            var i = internacoes.FirstOrDefault(x => x.Id == id && x.Status == "Em Internação");

            if (i != null)
            {
                i.Status = "Alta Concluída";
                i.DataAlta = DateTime.Now;
                var leito = leitos.FirstOrDefault(l => l.Id == i.LeitoId);
                if (leito != null) leito.EstaOcupado = false;
                Console.WriteLine("Alta registada com sucesso!");
            }
            else Console.WriteLine("Internação não encontrada.");
        }

        static void ListarInternados()
        {
            var ativos = internacoes.Where(i => i.Status == "Em Internação");
            foreach (var i in ativos)
            {
                var p = pacientes.FirstOrDefault(x => x.Id == i.PacienteId);
                TimeSpan tempo = DateTime.Now - i.DataEntrada;
                Console.WriteLine($"ID: {i.Id} | Paciente: {p?.Nome} | Leito: {i.LeitoId} | Horas Internado: {tempo.TotalHours:F1}h");
            }
        }

        static void ExibirRelatorio()
