using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Globalization;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace salario_minimo
{
    internal class Program
    {
        static void Main(string[] args)
        {

            Double salarioMinimo = 1518.00;



            Console.Write("Digite o valor do seu salário:");

            Double salarioUsuario = double.Parse(Console.ReadLine());



            Double quantidadeSalarios = salarioUsuario / salarioMinimo;



            Console.WriteLine($"Você ganha + quantidadeSalarios salarioMinimo.");




        }
    }
}
